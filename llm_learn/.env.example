# ============================================================
# 把它复制一份、改名为 .env，然后填上你自己的值
#     copy .env.example .env
# ⚠️ .env 里是密钥，绝对不要提交到 GitHub！
#    确认 .gitignore 里有 ".env" 这一行
# ============================================================

# 1) 接口地址：你用的哪家，就填哪家的（见下表）
#    注意结尾通常带 /v1，但不要带 /chat/completions
LLM_BASE_URL=https://api.deepseek.com/v1

# 2) 你的 API Key（各家控制台里创建，一般以 sk- 开头）
LLM_API_KEY=sk-在这里粘贴你的key

# 3) 模型名（必须是那家真实存在的模型 id，写错会报 model not found）
LLM_MODEL=deepseek-chat
